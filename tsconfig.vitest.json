{
  "extends": "./tsconfig.app.json",

  // 対象をテストファイルに絞り、アプリ向け設定の除外指定を解除する。
  // テストから読み込むアプリのコードは、モジュール解決によって自動的に含まれる。
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitestの実行環境に合わせて、標準ライブラリと読み込む型を指定する。
    "lib": [],
    "types": ["node", "jsdom"],

    // 増分ビルドの情報はプロジェクト直下に置かず、一時ディレクトリに保存する。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
