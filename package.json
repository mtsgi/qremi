{
  "name": "qremi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:android": "vp run build -- --base=/",
    "preview": "vp preview",
    "test:unit": "vp test",
    "build-only": "vp build",
    "type-check": "vp run typecheck",
    "format": "vp run fmt -- src/",
    "android:sync": "vp run build:android && vp exec cap sync android",
    "android:open": "vp exec cap open android",
    "android:apk:debug": "vp run android:sync && node ./scripts/build-android-apk.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@liquid-js/qr-code-styling": "^5.6.1",
    "qr-scanner": "^1.4.2",
    "vue": "rc"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vizejs/vite-plugin": "^0.569.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "npm:typescript-native-bridge@latest",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vue/compat": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "typescript": "$typescript",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "vue": "rc"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
