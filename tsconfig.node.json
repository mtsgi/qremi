// トランスパイルまたは型の除去により、Node.js上で実行するモジュール向けの設定。
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "capacitor.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // 多くのツールはトランスパイルを行うため、バンドラー向けのモジュール解決を使用する。
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Node.jsの型を読み込み、他の@typesパッケージが意図せず含まれることを防ぐ。
    "types": ["node"],

    // このプロジェクトは型チェック専用とし、ファイルを出力しない。
    "noEmit": true,

    // 増分ビルドの情報はプロジェクト直下に置かず、一時ディレクトリに保存する。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
